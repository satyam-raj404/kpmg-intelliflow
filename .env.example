# PostgreSQL connection — KPMG on-prem server default (user: postgres, password: 1234)
DATABASE_URL=postgresql://postgres:1234@localhost:5432/intellisource

# ── AI features (Ask IntelliSource) ──────────────────────────────────────────
# Leave the key blank to disable AI. The UI stays visible but greys out with a
# clear message and POST /api/chat returns a canned reply instead of calling a
# model. The key is read at IMPORT time, so set it before starting the backend.
OPENROUTER_API_KEY=

# Model per role, as "provider:model". Blank uses the built-in default
# (openrouter:openai/gpt-4o), which is a PAID model — set these to a free
# tool-calling model if you have no OpenRouter credits.
HARNESS_PLANNER_MODEL=
HARNESS_SQL_MODEL=
HARNESS_NARRATOR_MODEL=
# Escalation tier used by every role on a provider outage or 429.
HARNESS_HARD_REASON_MODEL=

# Fully local alternative — no key, no data leaving the machine. Requires Ollama
# running AND at least one HARNESS_*_MODEL set to "ollama:<model>", otherwise
# ai_enabled() still reports false.
# OLLAMA_BASE_URL=http://localhost:11434

# ── Read-only database role for the AI agent ──────────────────────────────────
# The agent connects on a separate, SELECT-only role. Provision it once:
#   psql "$DATABASE_URL" -f backend/scripts/setup_harness_ro_role.sql
# Without it the rest of the app works but every AI tool fails at connect.
# HARNESS_DATABASE_URL=postgresql://intellisource_harness_ro:harness_ro_pw@localhost:5432/intellisource