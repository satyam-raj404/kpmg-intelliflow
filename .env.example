# Gemini via Vertex AI express-mode API key ("AQ.…"), GCP project 243936589471.
# Project is overridable with GEMINI_PROJECT; sent as x-goog-api-key to aiplatform.googleapis.com.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional OpenRouter fallback / alternative provider
OPENROUTER_API_KEY=
# Harness model tiers — "provider:model_id" (Vertex ids carry the google/ prefix)
HARNESS_PLANNER_MODEL=gemini:google/gemini-2.5-flash
HARNESS_SQL_MODEL=gemini:google/gemini-2.5-flash
HARNESS_NARRATOR_MODEL=gemini:google/gemini-2.5-flash
HARNESS_HARD_REASON_MODEL=gemini:google/gemini-2.5-pro
